# Required for Google OAuth. Create an OAuth 2.0 Web application client in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional for unauthenticated public metadata checks with `npm run feasibility`.
YOUTUBE_API_KEY=

# Comma-separated public YouTube video IDs for metadata testing.
YOUTUBE_TEST_VIDEO_IDS=dQw4w9WgXcQ
PORT=3000

# Phase 1 storage. Required outside DEMO_MODE.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youtube_interest_radar
# A base64-encoded 32-byte key. Generate locally: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Set true to use bundled, clearly-labelled fixtures instead of OAuth/PostgreSQL.
DEMO_MODE=true
# In production, use HTTPS so the auth cookie can be marked Secure.
COOKIE_SECURE=false
